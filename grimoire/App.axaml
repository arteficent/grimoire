<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="grimoire.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#0B1020" />
    <SolidColorBrush x:Key="PanelBackground" Color="#111A2E" />
    <SolidColorBrush x:Key="PanelBorder" Color="#1F2C4A" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E6ECFF" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A9BBE" />
    <SolidColorBrush x:Key="Accent" Color="#7AA2FF" />
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Code viewer lines -->
    <Style Selector="Border.codeLine">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.35" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.codeLine.active">
      <Setter Property="Background" Value="#33507DFF" />
    </Style>
    <Style Selector="Border.codeLine TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#9FB0D3" />
    </Style>
    <Style Selector="Border.codeLine.active TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.codeLine TextBlock.lineNo">
      <Setter Property="Foreground" Value="#4A5A80" />
    </Style>

    <!-- Transport buttons -->
    <Style Selector=":is(Button).transport">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#1A2540" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3D63DD" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5277F0" />
    </Style>
    <Style Selector="ToggleButton.transport:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#5B3FA8" />
    </Style>

    <!-- Clickable cards (tracks, lessons) -->
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-3px)" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#16213A" />
      <Setter Property="BorderBrush" Value="#3D63DD" />
    </Style>

    <!-- Quiet text-like buttons (back links) -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#16213A" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="#1A2540" />
    </Style>

    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </Application.Styles>
</Application>
