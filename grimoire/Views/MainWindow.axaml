<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:grimoire.ViewModels"
        xmlns:r="using:grimoire.Rendering"
        x:Class="grimoire.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="grimoire"
        Icon="/Assets/grimoire.ico"
        Width="1480" Height="940" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

  <Window.Resources>
    <DataTemplate x:Key="LessonCardTemplate" x:DataType="vm:LessonCard">
      <Button Classes="tile" Width="360" MinHeight="138"
              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLessonCommand}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="46" Height="46" CornerRadius="12" VerticalAlignment="Top" Background="{Binding Accent}">
            <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="13" Foreground="#0B1020"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
              <Border Classes="chip">
                <TextBlock Text="{Binding StepsLabel}" FontSize="11" Foreground="{StaticResource TextMuted}" />
              </Border>
              <Border Classes="chip" IsVisible="{Binding HasLive}" Background="#2A1E3D">
                <TextBlock Text="runnable demo" FontSize="11" Foreground="#C4B5FD" />
              </Border>
              <Border Classes="chip" IsVisible="{Binding IsDone}" Background="#12352B">
                <TextBlock Text="completed" FontSize="11" Foreground="#6EE7B7" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Panel>

    <!-- ============================== HOME ============================== -->
    <ScrollViewer IsVisible="{Binding IsHome}">
      <StackPanel Margin="56,48,56,40" MaxWidth="1180" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="/Assets/grimoire.png" Width="48" Height="48" VerticalAlignment="Center" />
          <TextBlock Text="grimoire" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
          <Border Classes="chip" VerticalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{StaticResource TextMuted}" />
          </Border>
        </StackPanel>
        <TextBlock Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="16" LineHeight="26"
                   Foreground="{StaticResource TextMuted}"
                   Text="A visual knowledge base for the hard parts of computer and software engineering. Pick a topic, then step through short animated lessons at your own pace. Open 'Go deeper' only when you want the hardware detail." />
        <TextBox Margin="0,28,0,28" Width="560" HorizontalAlignment="Left" FontSize="15" Padding="14,10"
                 Watermark="{Binding SearchHint}" Text="{Binding SearchText}" />

        <ItemsControl ItemsSource="{Binding Tracks}" IsVisible="{Binding !HasSearch}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackCard">
              <Button Classes="tile" Width="364" Height="214"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenTrackCommand}"
                      CommandParameter="{Binding}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                  <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left" Background="{Binding Accent}">
                    <TextBlock Text="{Binding Monogram}" FontSize="18" FontWeight="Bold" Foreground="#0B1020"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Row="1" Margin="0,14,0,4" Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Grid.Row="2" Text="{Binding Tagline}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Row="3" Text="{Binding CountLabel}" FontSize="12" FontWeight="Bold" Foreground="{Binding Accent}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding SearchResults}" IsVisible="{Binding HasSearch}" ItemTemplate="{StaticResource LessonCardTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ============================== TRACK ============================== -->
    <DockPanel IsVisible="{Binding IsTrack}">
      <Border DockPanel.Dock="Top" Padding="40,20,40,12">
        <StackPanel Spacing="14" MaxWidth="1180" HorizontalAlignment="Left">
          <Button Classes="link" Content="&lt;  All topics" Command="{Binding GoHomeCommand}" HorizontalAlignment="Left" />
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="60" Height="60" CornerRadius="16" Background="{Binding CurrentTrack.Accent}">
              <TextBlock Text="{Binding CurrentTrack.Monogram}" FontSize="20" FontWeight="Bold" Foreground="#0B1020"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="{Binding CurrentTrack.Tagline}" FontSize="14.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <ScrollViewer>
        <ItemsControl Margin="40,8,40,40" ItemsSource="{Binding CurrentTrack.Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionGroup">
              <StackPanel Margin="0,8,0,10">
                <TextBlock Classes="caption" Text="{Binding Name}" Margin="2,0,0,12" />
                <ItemsControl ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource LessonCardTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- ============================== LESSON ============================== -->
    <Grid IsVisible="{Binding IsLesson}" RowDefinitions="Auto,*,Auto" Margin="20,12,20,16">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
        <Button Classes="link" Content="{Binding CurrentTrack.Title, StringFormat='&lt;  {0}'}" Command="{Binding BackToTrackCommand}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding CurrentLesson.Title}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LessonPosition}" FontSize="12" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Classes="transport" Content="Run the real code" IsVisible="{Binding HasLive}" IsChecked="{Binding IsLiveOpen}" />
          <Button Classes="transport" Content="Legend">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="320" Spacing="8" Margin="4">
                  <TextBlock Classes="caption" Text="COLOURS" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#7AA2FF" Text="Blue: active right now" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#34D399" Text="Green: done, correct, or holding a lock" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FBBF24" Text="Amber: waiting, queued, or a warning" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#F43F5E" Text="Red: the problem (deadlock, miss, overload)" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMuted}" Text="Dashed outline: freed, empty or no longer used" />
                  <TextBlock Classes="caption" Text="THREADS" Margin="0,6,0,0" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMuted}" Text="Solid green line = holds. Moving red dashes = waits for. Spinner = busy-waiting; padlock = asleep in the kernel." />
                  <TextBlock Classes="caption" Text="CACHE LINE STATES" Margin="0,6,0,0" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMuted}" Text="M modified, E exclusive, S shared, I invalid, R copy held in a register." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Body -->
      <Grid Grid.Row="1" ColumnDefinitions="*,400">
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <r:SceneCanvas Scene="{Binding CurrentScene}" Speed="{Binding AnimationSpeed}" Epoch="{Binding Epoch}" />
        </Border>

        <!-- Step explanation -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" IsVisible="{Binding !IsLiveOpen}">
          <StackPanel Spacing="14" Margin="0,4,8,4">
            <TextBlock Classes="caption" Text="{Binding StepLabel}" Foreground="{StaticResource Accent}" />
            <TextBlock Text="{Binding CurrentStep.Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="{Binding CurrentStep.Narrative}" FontSize="15.5" LineHeight="25" TextWrapping="Wrap" Foreground="#D5DEF5" />

            <Expander Header="Go deeper: hardware and internals" IsVisible="{Binding HasDeeper}" IsExpanded="{Binding IsDeeperOpen}" Margin="0,6,0,0">
              <TextBlock Text="{Binding CurrentStep.Hardware}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" Foreground="#DDD6FE" />
            </Expander>

            <Expander Header="Show code" IsVisible="{Binding HasCode}" IsExpanded="{Binding IsCodeOpen}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CodeLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CodeLine">
                      <Border Classes="codeLine" Classes.active="{Binding IsActive}">
                        <Grid ColumnDefinitions="24,*">
                          <TextBlock Classes="lineNo" Text="{Binding Number}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Expander>

            <Border Classes="card" Background="#0F2A22" BorderBrush="#1F5A45" IsVisible="{Binding IsLastStep}">
              <StackPanel Spacing="10">
                <TextBlock Classes="caption" Text="KEY TAKEAWAY" Foreground="#6EE7B7" />
                <TextBlock Text="{Binding Takeaway}" FontSize="14.5" LineHeight="23" TextWrapping="Wrap" Foreground="#D1FAE5" />
                <Button Classes="transport primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="NaN" Padding="14,8"
                        IsVisible="{Binding HasNextLesson}" Command="{Binding OpenNextLessonCommand}">
                  <TextBlock Text="{Binding NextLessonLabel}" TextWrapping="Wrap" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Live run -->
        <DockPanel Grid.Column="1" Margin="16,0,0,0" IsVisible="{Binding IsLiveOpen}">
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Classes="caption" Text="RUN THE REAL .NET CODE" Foreground="#C4B5FD" />
            <TextBlock Text="{Binding RunStatus}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       Text="The number in [brackets] is the managed thread id. Deadlocked threads cannot be killed and stay abandoned until the app closes." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="transport primary" Content="Run" Command="{Binding RunScenarioCommand}" IsEnabled="{Binding CanRun}" />
              <Button Classes="transport" Content="Cancel" Command="{Binding CancelRunCommand}" IsEnabled="{Binding IsRunning}" />
              <Button Classes="transport" Content="Clear" Command="{Binding ClearLogCommand}" />
            </StackPanel>
          </StackPanel>
          <Border Classes="card" Padding="4" Background="#080D1A">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,1" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Grid>

      <!-- Transport -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="transport" Content="&#x25C0;  Back" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}" />
          <Button Classes="transport primary" MinWidth="120" Content="Next  &#x25B6;" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoForward}" />
        </StackPanel>
        <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center" RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding StepLabel}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
          <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" CornerRadius="3" Foreground="{StaticResource Accent}" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="transport" Content="Restart" Command="{Binding RestartCommand}" />
          <Button Classes="transport" Content="{Binding PlayLabel}" Command="{Binding TogglePlayCommand}" />
          <Button Classes="transport" Content="Speed">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <StackPanel Width="260" Spacing="6" Margin="4">
                  <TextBlock Text="{Binding PlaySecondsLabel}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <Slider Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PlaySeconds}" />
                  <TextBlock Text="{Binding AnimationSpeedLabel}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <Slider Minimum="0.25" Maximum="2.5" Value="{Binding AnimationSpeed}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Panel>
</Window>
